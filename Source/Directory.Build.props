<Project>

  <PropertyGroup>
    <!--
      Build intermediates go outside the mod folder. RimWorld's Workshop uploader sends the whole
      folder (SteamUGC.SetItemContent on the root directory, no filtering possible): leaving obj/
      inside means publishing the 5.8 MB publicised Assembly-CSharp.dll, that is, redistributing
      the game's own code. This has to stay in a Directory.Build.props: NuGet restore reads this
      property before the csproj.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\DrumBathHygiene\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\DrumBathHygiene\</BaseOutputPath>
  </PropertyGroup>

</Project>
